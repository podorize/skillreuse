%% sbc-template.sty
%% LaTeX style file for SBC (Sociedade Brasileira de Computacao) conferences.
%% Conforms to the official SBC paper formatting instructions.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2003/03/24 SBC Conference Paper Style]

\RequirePackage{times}

%% Page dimensions for A4 paper:
%% Upper margin: 3.5 cm
%% Bottom margin: 2.5 cm
%% Left/Right margins: 3.0 cm
\setlength{\paperheight}{297mm}
\setlength{\paperwidth}{210mm}
\setlength{\topmargin}{3.5cm}
\addtolength{\topmargin}{-1in}
\setlength{\headheight}{0pt}
\setlength{\headsep}{0pt}
\setlength{\textheight}{23.7cm}
\setlength{\textwidth}{15.0cm}
\setlength{\oddsidemargin}{3.0cm}
\addtolength{\oddsidemargin}{-1in}
\setlength{\evensidemargin}{3.0cm}
\addtolength{\evensidemargin}{-1in}

%% Paragraph formatting: 6pt space before, 1.27cm indent
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{6pt}

%% Suppress page numbering
\pagestyle{empty}
\thispagestyle{empty}

%% Title, Author, Institute and Address formatting (Official SBC Standard)
\newcounter{instn}
\setcounter{instn}{1}
\newcommand{\instnum}{\arabic{instn}}
\newcommand{\inst}[1]{\ensuremath{^{#1}}}
\newcommand{\authortag}[1]{\ensuremath{^{#1}}}
\newcommand{\nextinstitute}{\\\mbox{}\\[-6pt]\addtocounter{instn}{1}\inst{\instnum}}
\newcommand{\email}[1]{\\\mbox{}\\[-6pt]\fontsize{10pt}{12pt}\selectfont\texttt{#1}}

\gdef\@address{}
\newcommand{\address}[1]{\gdef\@address{#1}}

\def\@maketitle{%
  \newpage
  \null
  \vskip 12pt
  \begin{center}%
    \let \footnote \thanks
    {\fontsize{16pt}{20pt}\selectfont \bfseries \@title \par}%
    \vskip 12pt
    {\fontsize{12pt}{14pt}\selectfont \bfseries
      \lineskip .5em%
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
    \vskip 6pt
    {\fontsize{12pt}{14pt}\selectfont
      \begin{tabular}[t]{c}%
        \@address
      \end{tabular}\par}%
  \end{center}%
  \par
  \vskip 12pt}

%% Section formatting: 13pt bold, 12pt before, 6pt after
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-12pt \@plus -3pt \@minus -2pt}%
  {6pt \@plus 2pt}%
  {\fontsize{13pt}{15pt}\selectfont\bfseries}}

%% Subsection formatting: 12pt bold, 12pt before, 6pt after
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-12pt \@plus -3pt \@minus -2pt}%
  {6pt \@plus 2pt}%
  {\fontsize{12pt}{14pt}\selectfont\bfseries}}

%% Subsubsection formatting: 12pt italic, 12pt before, 6pt after
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-12pt \@plus -3pt \@minus -2pt}%
  {6pt \@plus 2pt}%
  {\fontsize{12pt}{14pt}\selectfont\itshape}}

%% Abstract & Resumo environments: indented 0.8cm on both sides
\renewenvironment{abstract}{%
  \begin{list}{}{%
    \setlength{\leftmargin}{0.8cm}%
    \setlength{\rightmargin}{0.8cm}%
    \setlength{\listparindent}{0pt}%
    \setlength{\itemindent}{0pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\topsep}{6pt}%
  }%
  \item\relax\fontsize{12pt}{14pt}\selectfont \textbf{Abstract.}~%
}{%
  \end{list}\vspace{6pt}%
}

\newenvironment{resumo}{%
  \begin{list}{}{%
    \setlength{\leftmargin}{0.8cm}%
    \setlength{\rightmargin}{0.8cm}%
    \setlength{\listparindent}{0pt}%
    \setlength{\itemindent}{0pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\topsep}{6pt}%
  }%
  \item\relax\fontsize{12pt}{14pt}\selectfont \textbf{Resumo.}~%
}{%
  \end{list}\vspace{6pt}%
}

%% Caption styling: Helvetica 10pt bold
\RequirePackage{caption}
\DeclareCaptionFont{sbcfont}{\fontsize{10pt}{12pt}\fontfamily{phv}\selectfont\bfseries}
\captionsetup{font=sbcfont,skip=6pt}

%% References formatting (Official SBC Standard - Author-Date Hanging Indent)
\renewenvironment{thebibliography}[1]{%
  \section*{\refname}%
  \list{}{%
    \setlength{\leftmargin}{1.27cm}%
    \setlength{\itemindent}{-\leftmargin}%
    \setlength{\itemsep}{6pt}%
    \setlength{\parsep}{0pt}%
    \usecounter{enumiv}%
    \let\p@enumiv\@empty
    \renewcommand\theenumiv{\@arabic\c@enumiv}%
  }%
  \fontsize{12pt}{14pt}\selectfont
  \sloppy
  \clubpenalty4000
  \@clubpenalty \clubpenalty
  \widowpenalty4000%
  \sfcode`\.\@m%
}{%
  \def\@noitemerr{\@latex@warning{Empty `thebibliography' environment}}%
  \endlist%
}

\endinput
